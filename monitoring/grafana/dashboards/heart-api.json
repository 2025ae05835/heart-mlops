{
  "title": "Heart API - Service & Model Monitoring",
  "uid": "heart-api",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "type": "stat", "title": "Requests / sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "targets": [{"expr": "sum(rate(heart_api_requests_total[1m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}}
    },
    {
      "type": "stat", "title": "Error rate (5xx + 4xx)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "targets": [{"expr": "sum(rate(heart_api_requests_total{status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(heart_api_requests_total[5m])), 1e-9)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.2}]}}}
    },
    {
      "type": "stat", "title": "p95 latency",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(heart_api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}
    },
    {
      "type": "stat", "title": "Total predictions",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "targets": [{"expr": "sum(heart_api_predictions_total)", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Requests by endpoint & status",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (endpoint, status) (rate(heart_api_requests_total[1m]))", "legendFormat": "{{endpoint}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries", "title": "Latency p50 / p95 / p99 (/predict)",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(heart_api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(heart_api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(heart_api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries", "title": "Predictions by risk band (drift signal)",
      "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (risk_band) (rate(heart_api_predictions_total[5m]))", "legendFormat": "{{risk_band}}", "refId": "A"}]
    },
    {
      "type": "bargauge", "title": "Distribution of predicted P(disease)",
      "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (le) (increase(heart_api_prediction_probability_bucket[30m]))", "legendFormat": "<= {{le}}", "format": "heatmap", "refId": "A"}],
      "options": {"orientation": "vertical", "displayMode": "gradient"}
    }
  ]
}
